{
  "compilerOptions": {
    /* ES2020 for BigInt literals, which lib/store/db.ts needs: a Postgres
       advisory lock key is a signed 64-bit integer and JS has exactly one
       type that holds one without rounding. Writing the FNV constants as
       Number would silently lose precision above 2^53 and hand two
       different org ids the same lock. */
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    /* For app code this is only an earlier warning: next lint already flags
       an unused symbol and next build fails on it, so this moves the news into
       the check people run mid-edit.

       For tests/ it is the only check there is, from any tool, at any point.
       next lint does not reach test files, and next build type-checks the app
       graph, which tests are not part of. Verified rather than assumed: at
       52db7c2, on one checkout, tsc --noEmit exited 1 on tests/matching.test.ts
       while next build exited 0. See docs/green-tests-broken-build.md, 1 and 7. */
    "noUnusedLocals": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}

# Break Compliance — leave blank to run on demo data.
#
# Auth is OAuth2 client credentials, issued under Connecteam
# Settings → Integrations. A client id/secret pair is NOT an API key:
# sending one as X-API-KEY returns 403 "Invalid API key".
CONNECTEAM_CLIENT_ID=
CONNECTEAM_CLIENT_SECRET=

# Alternative to the pair above: a legacy Open API key, sent as X-API-KEY.
CONNECTEAM_API_KEY=

# Scopes the integration must be granted for live mode:
#   time_clock.read   punches and break types      (required)
#   schedule.read     rostered end times           (required for predictive timers)
#   users.read        names and employment type    (falls back to ids without it)
#   pay_rates.read    ordinary hourly rate         (money column is blank without it)
# One clock, or several separated by commas. An operator with a venue, a
# gaming room and an off-premise crew runs a clock each — reading one of them
# shows a third of the floor as though it were the whole floor.
CONNECTEAM_TIME_CLOCK_ID=
CONNECTEAM_SCHEDULER_ID=
CONNECTEAM_SITE_NAME=Brightwater Hotel
TZ_VENUE=Australia/Melbourne
CONNECTEAM_POLL_SECONDS=30

# Weekly payroll delivery — where last week's break-loading CSV is written.
# Point it at whatever folder payroll already opens: a synced drive, a mapped
# share. The filename carries the venue and the week, and re-running a week
# that has not changed rewrites nothing and records nothing.
REPORTS_DIR=

# Shared secret for POST /api/reports/weekly/run. Required — unset, the
# endpoint refuses everyone. It writes files, and this app is sometimes bound
# to 0.0.0.0 so a phone on the venue Wi-Fi can reach /m; open, it would let
# anyone on that network write into the payroll folder. Any long random
# string: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
REPORTS_RUN_TOKEN=
